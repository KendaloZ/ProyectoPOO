<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="300" prefWidth="490.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.view.SeleccionarMedicamentoViewController">

    <TableView fx:id="tablaMedicamento" layoutX="20" layoutY="20" prefHeight="220" prefWidth="447.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="80" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="258.0" text="Nombre" />
         <TableColumn fx:id="colDisponibilidad" prefWidth="110.0" text="Disponibilidad" />
        </columns>
    </TableView>

    <Button layoutX="205.0" layoutY="246.0" onAction="#cerrar" styleClass="hover-button" stylesheets="@../CSS/estilos.CSS" text="Cerrar" />
</AnchorPane>
